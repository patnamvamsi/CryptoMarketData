# Application Configuration
APP_NAME=VRITTI
START_OF_TIME=1483228800

# Binance API Keys
API_KEY=your_binance_api_key_here
API_SECRET=your_binance_api_secret_here
COINBASE=your_coinbase_password_here

# Data Storage
DATA_ROOT_DIR=/path/to/your/data/directory

# TimescaleDB Configuration
TIMESCALE_USERNAME=postgres
TIMESCALE_PASSWORD=your_timescale_password_here
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_MARKET_DATA_DB=market_data_dev1

# Kafka Configuration
STREAM_MARKET_DATA_KAFKA=False
STREAM_TICKER_KAFKA=True
STREAM_APP_LOG_KAFKA=False
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_MARKET_DATA_TOPIC=MARKET_DATA
KAFKA_APP_LOG_TOPIC=APPLICATION_LOGS
KAFKA_MARKET_NEWS_TOPIC=MARKET_NEWS
KAFKA_ORDERS_TOPIC=ORDERS
KAFKA_TRADES_TOPIC=TRADES

# Zerodha API Keys
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_SECRET_KEY=your_zerodha_secret_key_here

# Zerodha Automated Authentication (Optional)
# Provide these credentials to enable automated daily authentication
# If not provided, manual token generation via scripts/zerodha_auth.py is required
ZERODHA_USERNAME=your_zerodha_user_id_here
ZERODHA_PASSWORD=your_zerodha_password_here
ZERODHA_TOTP_KEY=your_totp_secret_key_here
ENABLE_ZERODHA_AUTO_AUTH=True

# Zerodha Configuration
ZERODHA_EXCHANGE_SEGMENT=NSE
ZERODHA_DEFAULT_INTERVAL=1m
ENABLE_ZERODHA_STREAMING=True
ENABLE_ZERODHA_GAP_FILL=True
ZERODHA_MAX_DAYS_BACK=60
